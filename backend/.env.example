# Local PostgreSQL connection fields. backend/.env is read only by LoadLocal.
# Keep the real password in backend/.env or a secret manager, never in Git.
host=127.0.0.1
port=5432
username=postgres
password=replace-me
database=gogetsomefoodferris

# Optional API settings.
# API_ADDR=127.0.0.1:8080
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name
# DEEPSEEK_API_KEY=replace-me
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_PRIMARY_MODEL=deepseek-v4-flash
# DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro
# ADMIN_SESSION_TTL=12h
# ADMIN_COOKIE_SECURE=false
# ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5
